{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "rootDir": "src",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/webview"]
}
